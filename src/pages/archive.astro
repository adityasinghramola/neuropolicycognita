---
import Base from '../layouts/Base.astro';
import ArticleBrowser from '../components/ArticleBrowser.astro';
import { allArticles, SECTIONS, LENS_ORDER } from '../lib/site';
const articles = await allArticles();
const list = articles.map((article) => ({ article, tags: [article.data.section] }));
const filters = LENS_ORDER.map((k) => ({ key: k, label: SECTIONS[k].label }));
---
<Base title="All essays" description="Every essay published on NeuroPolicy Cognita.">
  <div class="wrap">
    <header class="page-head">
      <span class="badge solid">Archive</span>
      <h1>All essays</h1>
      <p class="lede">{articles.length} {articles.length === 1 ? 'essay' : 'essays'} across finance, politics, marketing and the mind.</p>
    </header>
    <ArticleBrowser articles={list} filters={filters} />
  </div>
</Base>
<style>
  .page-head{border-bottom:0;margin-bottom:8px}
</style>
