---
import Base from '../layouts/Base.astro';
import ArticleBrowser from '../components/ArticleBrowser.astro';
import { allArticles, inSection, url, SECTIONS, LENS_ORDER, type Lens } from '../lib/site';

export function getStaticPaths() {
  return LENS_ORDER.map((section) => ({ params: { section } }));
}
const section = Astro.params.section as Lens;
const s = SECTIONS[section];
// Each section lists only the essays filed in it.
const { home } = inSection(await allArticles(), section);
const list = home.map((article) => ({ article, tags: [section] }));
---
<Base title={s.label} description={s.lede} active={section}>
  <div class={`wrap ${section}`}>
    <header class="page-head">
      <span class="badge solid">{s.label}</span>
      <h1>{s.title}</h1>
      <p class="lede">{s.lede}</p>
    </header>

    {list.length > 0 ? (
      <ArticleBrowser articles={list} />
    ) : (
      <div class="empty">
        <h2>First essays coming soon</h2>
        <p>Questions this section will take on:</p>
        <ul>{s.questions.map((q) => <li>{q}</li>)}</ul>
        <a class="btn" href={url('/contact/')}>Pitch an essay</a>
      </div>
    )}
  </div>
</Base>

<style>
  .page-head{border-bottom:0;margin-bottom:8px}
  .empty{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:clamp(24px,4vw,40px);display:grid;gap:14px;max-width:640px}
  .empty h2{font-size:var(--s4)}
  .empty ul{margin:0;padding-left:20px;color:var(--muted);display:grid;gap:6px}
  .empty .btn{justify-self:start;margin-top:8px}
</style>
