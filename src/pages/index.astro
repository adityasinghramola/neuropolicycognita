---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LensMap from '../components/LensMap.astro';
import { allArticles, url, SECTIONS } from '../lib/site';

const articles = await allArticles();
const lead = articles.find((a) => a.data.featured) ?? articles[0];
const latest = lead ? [lead, ...articles.filter((a) => a !== lead).slice(0, 2)] : [];
const pillars = (['politics', 'marketing', 'finance'] as const);
const names: Record<string, string> = { politics: 'Political Thought', marketing: 'Marketing Strategy', finance: 'Financial Analysis' };
const icons: Record<string, string> = {
  politics: `<path d="M110 92 a50 50 0 0 1 100 0z" fill="none" stroke="var(--ink)" stroke-width="1.5"/><line x1="160" y1="20" x2="160" y2="42" stroke="var(--ink)" stroke-width="1.5"/><rect x="96" y="92" width="128" height="8" fill="var(--ink)"/><g stroke="var(--ink)" stroke-width="1.5"><line x1="108" y1="100" x2="108" y2="146"/><line x1="128" y1="100" x2="128" y2="146"/><line x1="148" y1="100" x2="148" y2="146"/><line x1="172" y1="100" x2="172" y2="146"/><line x1="192" y1="100" x2="192" y2="146"/><line x1="212" y1="100" x2="212" y2="146"/></g><rect x="86" y="146" width="148" height="8" fill="var(--c)"/>`,
  marketing: `<line x1="40" y1="90" x2="280" y2="90" stroke="var(--muted)"/><line x1="160" y1="20" x2="160" y2="160" stroke="var(--muted)"/><g fill="var(--ink)"><circle cx="96" cy="62" r="6"/><circle cx="120" cy="124" r="6"/><circle cx="196" cy="132" r="6"/><circle cx="214" cy="108" r="6"/><circle cx="82" cy="104" r="6"/></g><circle cx="222" cy="50" r="10" fill="var(--c)"/><circle cx="222" cy="50" r="22" fill="none" stroke="var(--c)" stroke-width="1.5"/>`,
  finance: `<g stroke="var(--ink)" stroke-width="1.5"><line x1="60" y1="96" x2="60" y2="150"/><line x1="96" y1="84" x2="96" y2="140"/><line x1="132" y1="100" x2="132" y2="150"/><line x1="168" y1="70" x2="168" y2="126"/><line x1="204" y1="56" x2="204" y2="110"/><line x1="240" y1="34" x2="240" y2="92"/><line x1="276" y1="28" x2="276" y2="76"/></g><g fill="var(--ink)"><rect x="53" y="108" width="14" height="30"/><rect x="125" y="110" width="14" height="28"/></g><g fill="var(--c)"><rect x="89" y="94" width="14" height="34"/><rect x="161" y="80" width="14" height="34"/><rect x="197" y="64" width="14" height="36"/><rect x="233" y="44" width="14" height="38"/><rect x="269" y="34" width="14" height="30"/></g>`,
};
---
<Base>
  <section class="hero">
    <canvas id="crossing" aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <span class="label">Behaviour · Policy · Markets</span>
      <h1>Strategic insights for a <em>complex</em> world</h1>
      <p>A thought space for the ideas that shape the way we think, decide, and act.</p>
      <div class="hero-cta">
        <a class="btn" href="#latest">Read the latest</a>
        <a class="btn ghost" href={url('/about/')}>About the project</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="intro">
      <h2>Curious minds making sense of how people choose.</h2>
      <div class="copy">
        <p>NeuroPolicy Cognita is a thought space for ideas that shape the way we think, decide, and act. From behavioural finance and marketing insights to politics, policy, and broader cultural reflections, the platform blends analysis with curiosity.</p>
        <p>It is not just one voice. Contributors from diverse fields share their perspectives, creating a space where disciplines intersect and new ways of understanding emerge. Whether it is decoding decision-making, exploring societal shifts, or reflecting on everyday behaviour, NeuroPolicy Cognita is about curious minds making sense of a complex world.</p>
      </div>
    </section>

    <section id="latest">
      <div class="section-head">
        <h2>Latest essays</h2>
        <a class="label" href={url('/archive/')}>All essays →</a>
      </div>
      <div class="cards lead">
        {latest.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>

    <section class="block">
      <div class="section-head">
        <h2>How the ideas connect</h2>
        <span class="label">Every essay sits between the fields it draws on</span>
      </div>
      <LensMap articles={articles} />
    </section>

    <section class="block">
      <div class="section-head">
        <h2>Areas of expertise</h2>
        <span class="label">Three lenses, one question: why do we decide the way we do?</span>
      </div>
      <div class="pillars">
        {pillars.map((k) => (
          <a class={`pillar ${k}`} href={url(`/${k}/`)}>
            <svg viewBox="0 0 320 180" aria-hidden="true"><rect width="320" height="180" fill="var(--stripe)" /><g set:html={icons[k]} /></svg>
            <h3>{names[k]}</h3>
            <p>{SECTIONS[k].short}</p>
            <span class="more">Explore {SECTIONS[k].label.toLowerCase()} →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="lens">
      <div><span class="label">Bias</span><b>Loss aversion</b><p>Losses weigh roughly twice as heavily as equal gains. It shapes portfolios, ballots and price tags.</p></div>
      <div><span class="label">Bias</span><b>Anchoring</b><p>The first number we hear sets the frame, from an IPO price band to a budget announcement.</p></div>
      <div><span class="label">Bias</span><b>Default effect</b><p>Most people keep the pre-selected option. Good policy design starts with good defaults.</p></div>
      <div><span class="label">Bias</span><b>Herding</b><p>Crowds move markets and movements alike. Knowing when you are in one is half the edge.</p></div>
    </section>
  </div>
</Base>

<style>
  .hero{position:relative;border-bottom:1px solid var(--line);overflow:hidden}
  #crossing{position:absolute;inset:0;width:100%;height:100%;display:block;-webkit-mask-image:linear-gradient(90deg,transparent 38%,#000 80%);mask-image:linear-gradient(90deg,transparent 38%,#000 80%)}
  .hero-inner{position:relative;padding-block:clamp(72px,12vw,140px) clamp(56px,9vw,104px)}
  .hero h1{font-size:var(--s6);max-width:12ch;letter-spacing:-.01em}
  .hero h1 em{font-style:normal;color:var(--accent-ink)}
  .hero p{max-width:46ch;margin-top:24px;font-size:var(--s3);color:var(--muted);line-height:1.5}
  .hero .label{margin-bottom:22px;display:block}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:36px}
  .intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr);gap:clamp(24px,6vw,96px);padding-block:clamp(56px,9vw,104px)}
  .intro h2{font-size:var(--s5)}
  .intro .copy{display:grid;gap:18px;font-size:1.075rem;max-width:62ch}
  .intro .copy p:first-child::first-letter{font-family:var(--display);float:left;font-size:3.6rem;line-height:.85;padding:6px 10px 0 0;color:var(--accent-ink)}
  @media (max-width:760px){.intro{grid-template-columns:1fr}}
  .block{margin-top:clamp(64px,9vw,112px)}
  .pillars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
  .pillar{background:var(--surface);padding:28px 26px 30px;display:grid;grid-template-rows:auto auto 1fr auto;gap:14px;text-decoration:none;min-width:0;transition:background .2s}
  .pillar:hover{background:color-mix(in srgb,var(--surface) 90%,var(--c))}
  .pillar svg{width:100%;height:auto;aspect-ratio:16/9;display:block}
  .pillar h3{font-size:1.6rem}
  .pillar p{color:var(--muted);font-size:.95rem}
  .pillar .more{font-family:var(--mono);font-size:var(--s1);color:var(--c)}
  @media (max-width:860px){.pillars{grid-template-columns:1fr}}
  .lens{margin-top:clamp(56px,8vw,96px);display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
  .lens div{border-top:1px solid var(--line);padding-top:14px;min-width:0}
  .lens b{display:block;font-family:var(--display);font-weight:400;font-size:1.25rem;margin:6px 0}
  .lens p{font-size:.9rem;color:var(--muted)}
  @media (max-width:760px){.lens{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

<script>
  // Hero: pedestrians crossing a zebra crossing, a nod to the original site's photo.
  const c = document.getElementById('crossing') as HTMLCanvasElement | null;
  if (c) {
    const ctx = c.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, H = 0;
    type P = { x: number; y: number; v: number; r: number; a: boolean };
    let people: P[] = [];
    const css = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
    const size = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const r = c.getBoundingClientRect(); W = r.width; H = r.height;
      c.width = W * dpr; c.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      people = Array.from({ length: Math.round(W / 34) }, () => ({
        x: W * 0.42 + Math.random() * W * 0.58, y: Math.random() * H,
        v: (Math.random() < 0.5 ? -1 : 1) * (0.15 + Math.random() * 0.45),
        r: 2.4 + Math.random() * 2.2, a: Math.random() < 0.14,
      }));
    };
    const draw = () => {
      const paper = css('--paper');
      ctx.fillStyle = paper; ctx.fillRect(0, 0, W, H);
      const x0 = W * 0.42, sw = Math.max(16, H / 14);
      ctx.fillStyle = css('--stripe');
      for (let y = sw * 0.5; y < H; y += sw * 2) ctx.fillRect(x0, y, W - x0, sw);
      const ink = css('--muted'), acc = css('--accent');
      for (const p of people) {
        if (!reduce) { p.y += p.v; if (p.y < -10) p.y = H + 10; if (p.y > H + 10) p.y = -10; }
        ctx.fillStyle = p.a ? acc : ink; ctx.globalAlpha = p.a ? 0.9 : 0.55;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (!reduce) requestAnimationFrame(draw);
    };
    size(); addEventListener('resize', () => { size(); if (reduce) draw(); }); draw();
  }
</script>
