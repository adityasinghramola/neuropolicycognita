---
// Featured lead story, filter buttons, then a grid of cards.
// Each card carries data-tags; a filter shows the cards whose tags include its key.
import ArticleCard from './ArticleCard.astro';
import FeaturedArticle from './FeaturedArticle.astro';
import type { Article } from '../lib/site';

interface Props {
  articles: { article: Article; tags: string[] }[];
  filters?: { key: string; label: string }[];
}
const { articles, filters = [] } = Astro.props;
const [lead, ...rest] = articles;
const usable = filters.filter((f) => rest.some((r) => r.tags.includes(f.key)));
---
{lead && <FeaturedArticle article={lead.article} />}

{rest.length > 0 && (
  <div class="browser">
    {usable.length > 1 && (
      <div class="filters" role="group" aria-label="Filter essays">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        {usable.map((f) => <button type="button" data-filter={f.key} aria-pressed="false">{f.label}</button>)}
      </div>
    )}
    <div class="cards">
      {rest.map((r) => <ArticleCard article={r.article} tags={r.tags.join(' ')} />)}
    </div>
    <p class="no-match" hidden>No essays here yet.</p>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('.browser').forEach((box) => {
    const buttons = box.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = box.querySelectorAll<HTMLElement>('.card');
    const empty = box.querySelector<HTMLElement>('.no-match');
    buttons.forEach((btn) => btn.addEventListener('click', () => {
      const key = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      cards.forEach((c) => {
        const on = key === 'all' || (c.dataset.tags ?? '').split(' ').includes(key);
        c.hidden = !on; if (on) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }));
  });
</script>
