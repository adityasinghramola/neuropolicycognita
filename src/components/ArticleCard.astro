---
import Cover from './Cover.astro';
import { url, SECTIONS, fmtDate, readingTime, initials, type Article } from '../lib/site';
interface Props { article: Article; showDesc?: boolean; tags?: string }
const { article, showDesc = true, tags } = Astro.props;
const d = article.data;
const href = url(`/articles/${article.id}/`);
---
<article class={`card ${d.section}`} data-tags={tags}>
  <div class="cover">
    {d.cover && <Cover src={d.cover} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 360px" />}
    <span class="pill-time"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>{readingTime(article.body)} min read</span>
  </div>
  <div class="body">
    <span class="badge">{SECTIONS[d.section].label}</span>
    <h3><a href={href}>{d.title}</a></h3>
    {showDesc && <p>{d.description}</p>}
  </div>
  <div class="byline">
    <span class="avatar" aria-hidden="true">{initials(d.author)}</span>
    <div><b>{d.author}</b><span>{fmtDate(d.date)}</span></div>
  </div>
</article>
